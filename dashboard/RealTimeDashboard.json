  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "hydro_latest\n| extend status = case(level_cm >= alarm_level_cm, \"alarm\", level_cm >= warning_level_cm, \"ostrzegawczy\", \"normalny\")\n| join kind=inner (dim_river_gauge | project gauge_id, gauge_name, lat, lon) on gauge_id\n| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code\n| project gauge_name, river, gmina_name, level_cm, warning_level_cm, alarm_level_cm, trend, status, lat, lon\n| order by level_cm desc",
      "id": "c5f6996f-7f13-b5ac-e9ce-a8469472c338",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "hydro_readings\n| where timestamp between (datetime(2026-09-12T12:00:00+02:00) .. datetime(2026-09-25T12:00:00+02:00))\n| where gauge_id in (\"WG-001\", \"WG-003\", \"WG-004\", \"WG-007\")\n| summarize avg_level=avg(level_cm), max_level=max(level_cm) by bin(timestamp, 1h), gauge_id, river\n| order by timestamp asc",
      "id": "8019ec6b-2308-296c-c51d-a51946201cb8",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "hydro_readings\n| where timestamp between (datetime(2026-09-12T12:00:00+02:00) .. datetime(2026-09-25T12:00:00+02:00))\n| where level_cm >= alarm_level_cm\n| summarize [\"Gminy w alarmie\"]=dcount(gmina_code), [\"Wodowskazy w alarmie\"]=dcount(gauge_id), [\"Rzeki w alarmie\"]=dcount(river)\n| evaluate narrow()\n| project Wskaznik=Column, Wartosc=toint(Value)",
      "id": "b38f0b51-ca66-6e80-132e-54ece2c59d4e",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "incident_reports\n| where hazard_code == \"Z02\"\n| summarize incidents=count(), affected=sum(affected_people), max_priority=max(priority) by bin(timestamp, 15m)\n| order by timestamp asc",
      "id": "424aca17-b492-824d-984b-979842ba808d",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "incident_reports\n| where timestamp between (datetime(2026-09-12T12:00:00+02:00) .. datetime(2026-09-25T12:00:00+02:00))\n| where hazard_code == \"Z02\"\n| summarize incidents=count(), affected=sum(affected_people), high_priority=countif(priority >= 4) by gmina_code\n| top 20 by incidents desc",
      "id": "daadb2f3-2236-339a-ad76-690e03765cab",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "power_grid_events\n| summarize customers_offline=sum(customers_offline), events=count(), max_eta=max(eta_restore_min) by bin(timestamp, 1h)\n| order by timestamp asc",
      "id": "cddf8eea-3176-b8f9-e655-8d3b73e39e0a",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "power_grid_events\n| summarize customers_offline=sum(customers_offline), events=count(), max_eta_restore_min=max(eta_restore_min), causes=make_set(cause, 5) by gmina_code\n| top 15 by customers_offline desc",
      "id": "3475e7da-d41d-bb3a-db61-00ad4c9b333f",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "telecom_events\n| where coverage_pct < 50\n| summarize arg_max(timestamp, *) by gmina_code, operator\n| project timestamp, gmina_code, operator, coverage_pct, base_stations_down, cause\n| order by coverage_pct asc",
      "id": "9917d286-54e8-2a72-6264-1569804cc108",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "evacuation_status\n| summarize arg_max(timestamp, *) by gmina_code\n| summarize [\"Osoby w ewakuacji\"]=sum(people_count), [\"Gminy z ewakuacja\"]=dcount(gmina_code), [\"Miejsca w punktach przyjecia\"]=sum(reception_capacity)\n| evaluate narrow()\n| project Wskaznik=Column, Wartosc=toint(Value)",
      "id": "df1690d1-2cf7-1098-8737-98e73453ea75",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "resource_deployment\n| summarize arg_max(timestamp, *) by voivodeship_code\n| project timestamp, voivodeship_code, psp_units, wot_soldiers, pumps, generators, helicopters,\n          total_resources=psp_units + wot_soldiers + pumps + generators + helicopters\n| order by total_resources desc",
      "id": "286746ee-7e9a-cb49-51e8-31fc6d717dc7",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
