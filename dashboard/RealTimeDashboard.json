      "id": "dcf69cb5-31b7-9f27-c2ac-14c4391d1027"
    },
    {
      "name": "Z20 Dezinformacja",
      "id": "cf29945f-3398-69bc-ed0c-5279e4b881c9"
    }
  ],
  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "hydro_latest\n| extend status = case(level_cm >= alarm_level_cm, \"alarm\", level_cm >= warning_level_cm, \"ostrzegawczy\", \"normalny\")\n| join kind=inner (dim_river_gauge | project gauge_id, gauge_name, lat, lon) on gauge_id\n| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code\n| project gauge_name, river, gmina_name, level_cm, warning_level_cm, alarm_level_cm, trend, status, lat, lon\n| order by level_cm desc",
      "id": "c5f6996f-7f13-b5ac-e9ce-a8469472c338",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "hydro_readings\n| where timestamp between (_startTime .. _endTime)\n| where gauge_id in (\"WG-001\", \"WG-003\", \"WG-004\", \"WG-007\")\n| summarize avg_level=avg(level_cm), max_level=max(level_cm) by bin(timestamp, 1h), gauge_id, river\n| order by timestamp asc",
      "id": "8019ec6b-2308-296c-c51d-a51946201cb8",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "hydro_readings\n| where timestamp between (_startTime .. _endTime)\n| where level_cm >= alarm_level_cm\n| summarize [\"Gminy w alarmie\"]=dcount(gmina_code), [\"Wodowskazy w alarmie\"]=dcount(gauge_id), [\"Rzeki w alarmie\"]=dcount(river)\n| evaluate narrow()\n| project Wskaznik=Column, Wartosc=toint(Value)",
      "id": "b38f0b51-ca66-6e80-132e-54ece2c59d4e",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "incident_reports\n| where timestamp between (_startTime .. _endTime)\n| where hazard_code == \"Z02\"\n| summarize incidents=count(), affected=sum(affected_people), max_priority=max(priority) by bin(timestamp, 15m)\n| order by timestamp asc",
      "id": "424aca17-b492-824d-984b-979842ba808d",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "incident_reports\n| where timestamp between (_startTime .. _endTime)\n| where hazard_code == \"Z02\"\n| summarize Zgloszenia = count(), Osoby = sum(affected_people) by gmina_code\n| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code\n| top 15 by Zgloszenia desc\n| project Gmina = coalesce(gmina_name, gmina_code), Zgloszenia, Osoby\n| order by Zgloszenia asc",
      "id": "daadb2f3-2236-339a-ad76-690e03765cab",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "power_grid_events\n| where timestamp between (_startTime .. _endTime)\n| summarize customers_offline=sum(customers_offline), events=count(), max_eta=max(eta_restore_min) by bin(timestamp, 1h)\n| order by timestamp asc",
      "id": "cddf8eea-3176-b8f9-e655-8d3b73e39e0a",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "power_grid_events\n| where timestamp between (_startTime .. _endTime)\n| summarize Odbiorcy = sum(customers_offline), MaxETA = max(eta_restore_min) by gmina_code\n| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code\n| top 15 by Odbiorcy desc\n| project Gmina = coalesce(gmina_name, gmina_code), Odbiorcy, MaxETA\n| order by Odbiorcy desc",
      "id": "3475e7da-d41d-bb3a-db61-00ad4c9b333f",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "telecom_events\n| where timestamp between (_startTime .. _endTime)\n| where coverage_pct < 50\n| summarize arg_max(timestamp, coverage_pct, base_stations_down) by gmina_code\n| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code\n| top 15 by coverage_pct asc\n| project Gmina = coalesce(gmina_name, gmina_code), Pokrycie = coverage_pct, Stacje = base_stations_down\n| order by Pokrycie desc",
      "id": "9917d286-54e8-2a72-6264-1569804cc108",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "evacuation_status\n| where timestamp between (_startTime .. _endTime)\n| summarize arg_max(timestamp, *) by gmina_code\n| summarize [\"Osoby w ewakuacji\"]=sum(people_count), [\"Gminy z ewakuacja\"]=dcount(gmina_code), [\"Miejsca w punktach przyjecia\"]=sum(reception_capacity)\n| evaluate narrow()\n| project Wskaznik=Column, Wartosc=toint(Value)",
      "id": "df1690d1-2cf7-1098-8737-98e73453ea75",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "resource_deployment\n| where timestamp between (_startTime .. _endTime)\n| summarize arg_max(timestamp, psp_units, wot_soldiers, pumps, generators, helicopters) by voivodeship_code\n| join kind=leftouter (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code\n| extend Razem = psp_units + wot_soldiers + pumps + generators + helicopters\n| top 10 by Razem desc\n| project Wojewodztwo = coalesce(voivodeship_name, voivodeship_code), PSP = psp_units, WOT = wot_soldiers,\n          Pompy = pumps, Agregaty = generators, Smiglowce = helicopters",
      "id": "286746ee-7e9a-cb49-51e8-31fc6d717dc7",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "escalation_events\n| where timestamp between (_startTime .. _endTime)\n| where hazard_code == \"Z02\"\n| order by timestamp asc\n| project timestamp, from_level, to_level, area, recommended_spo, reason",
      "id": "057690da-f91a-d3a0-1eb1-daf8d55e79b8",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "media_signals\n| where timestamp between (_startTime .. _endTime)\n| where disinformation_flag == true or hazard_code == \"Z20\"\n| summarize disinfo_signals=count(), disinfo_reach=sum(reach), topics=make_set(topic, 5) by bin(timestamp, 1h)\n| order by timestamp asc",
      "id": "29192ae9-2d70-7fc6-076f-06771a87ad63",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "media_signals\n| where timestamp between (_startTime .. _endTime)\n| where disinformation_flag == true\n| summarize Zasieg = sum(reach), Sygnaly = count() by channel\n| project Kanal = channel, Zasieg, Sygnaly\n| order by Zasieg desc",
      "id": "599e29ef-6c06-3a19-86d0-b79bf91c9aaf",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "let hydro_alarm = hydro_readings\n| where timestamp between (_startTime .. _endTime)\n| where level_cm >= alarm_level_cm\n| summarize first_alarm=min(timestamp) by gmina_code;\nlet power_first = power_grid_events\n| where timestamp between (_startTime .. _endTime)\n| summarize first_power=min(timestamp), customers=sum(customers_offline) by gmina_code;\nlet telco_first = telecom_events\n| where timestamp between (_startTime .. _endTime)\n| summarize first_telco=min(timestamp), min_coverage=min(coverage_pct) by gmina_code;\nhydro_alarm\n| join kind=leftouter power_first on gmina_code\n| join kind=leftouter telco_first on gmina_code\n| extend power_delay_h=datetime_diff('hour', first_power, first_alarm), telco_delay_h=datetime_diff('hour', first_telco, first_alarm)\n| project gmina_code, first_alarm, first_power, power_delay_h, customers, first_telco, telco_delay_h, min_coverage\n| order by first_alarm asc",
      "id": "67cede41-377e-ca16-6e0f-4431e2d6e78d",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "incident_reports\n| where timestamp between (_startTime .. _endTime)\n| join kind=inner (dim_gmina | project gmina_code, powiat_code) on gmina_code\n| join kind=inner (dim_powiat | project powiat_code, voivodeship_code) on powiat_code\n| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code\n| summarize Zgloszenia = count() by Wojewodztwo = voivodeship_name, Doba = format_datetime(bin(timestamp, 1d), 'MM-dd')\n| order by Doba asc",
      "id": "64927ecc-2324-888d-c648-bc28c19172f5",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "incident_reports\n| where timestamp between (_startTime .. _endTime)\n| summarize Osoby = sum(affected_people) by Czas = bin(timestamp, 1h)\n| order by Czas asc\n| extend Skumulowane = row_cumsum(Osoby)",
      "id": "86a0e303-e60a-e04c-9b29-13b317bd3148",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "incident_reports\n| where timestamp between (_startTime .. _endTime)\n| summarize Zgloszenia = count(), Osoby = sum(affected_people) by gmina_code\n| join kind=inner (dim_gmina | project gmina_code, gmina_name, lat, lon) on gmina_code\n| project Gmina = gmina_name, Zgloszenia, Osoby, lat, lon\n| order by Zgloszenia desc",
      "id": "9dcf4a32-4b32-d331-344b-c68e22465a33",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "let ostatnie = toscalar(\n    union isfuzzy=true\n        (hydro_readings | summarize m = max(timestamp)),\n        (incident_reports | summarize m = max(timestamp)),\n        (power_grid_events | summarize m = max(timestamp)),\n        (telecom_events | summarize m = max(timestamp))\n    | summarize max(m));\nprint Wskaznik = 'Opoznienie strumienia [s]', Wartosc = toint((now() - ostatnie) / 1s)",
      "id": "97d4d0b5-a1a8-db74-4568-4a857d07518d",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "700b6b99-befb-30ef-0c3a-1043f13daa16"
      },
      "text": "union isfuzzy=true\n    (hydro_readings | where timestamp between (_startTime .. _endTime) | project timestamp, Strumien = 'Hydrologia'),\n    (incident_reports | where timestamp between (_startTime .. _endTime) | project timestamp, Strumien = 'Zgloszenia'),\n    (power_grid_events | where timestamp between (_startTime .. _endTime) | project timestamp, Strumien = 'Energetyka'),\n    (telecom_events | where timestamp between (_startTime .. _endTime) | project timestamp, Strumien = 'Telekomunikacja')\n| summarize Zdarzenia = count() by Czas = bin(timestamp, 1m), Strumien\n| order by Czas asc",
      "id": "c11360b4-b487-73c3-ed38-3e9d682470c0",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    }
  ]
}