table incident_reports
	sourceLineageTag: [dbo].[incident_reports]

	column timestamp
		dataType: dateTime
		sourceLineageTag: timestamp
		summarizeBy: none
		sourceColumn: timestamp

	column stream
		dataType: string
		sourceLineageTag: stream
		summarizeBy: none
		sourceColumn: stream

	column incident_id
		dataType: string
		sourceLineageTag: incident_id
		summarizeBy: none
		sourceColumn: incident_id

	column source
		dataType: string
		sourceLineageTag: source
		summarizeBy: none
		sourceColumn: source

	column hazard_code
		dataType: string
		sourceLineageTag: hazard_code
		summarizeBy: none
		sourceColumn: hazard_code

	column event_type
		dataType: string
		sourceLineageTag: event_type
		summarizeBy: none
		sourceColumn: event_type

	column gmina_code
		dataType: int64
		formatString: 0
		sourceLineageTag: gmina_code
		summarizeBy: sum
		sourceColumn: gmina_code

	column priority
		dataType: int64
		formatString: 0
		sourceLineageTag: priority
		summarizeBy: sum
		sourceColumn: priority

	column injured_count
		dataType: int64
		formatString: 0
		sourceLineageTag: injured_count
		summarizeBy: sum
