	column affected_people
		dataType: int64
		formatString: 0
		sourceLineageTag: affected_people
		summarizeBy: sum
		sourceColumn: affected_people

	column status
		dataType: string
		sourceLineageTag: status
		summarizeBy: none
		sourceColumn: status

	partition incident_reports = entity
		mode: directLake
		source
			entityName: incident_reports
			expressionSource: 'DirectLake - OL_COP24_Lakehouse'
