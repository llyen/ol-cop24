table kis_voivodeship
	sourceLineageTag: [dbo].[kis_voivodeship]

	column voivodeship_code
		dataType: string
		sourceLineageTag: voivodeship_code
		summarizeBy: none
		sourceColumn: voivodeship_code

	column kis
		dataType: double
		sourceLineageTag: kis
		summarizeBy: sum
		sourceColumn: kis

	column max_kis
		dataType: double
		sourceLineageTag: max_kis
		summarizeBy: sum
		sourceColumn: max_kis

	partition kis_voivodeship = entity
		mode: directLake
		source
