// 📊 COP-24 — zapytania kafelków Real-Time Dashboard
// Parametry używane w dashboardzie (do podstawienia w UI):
//   _startTime / _endTime — przedział czasu, np. D-3...D+10
//   _voivodeshipCode — kod TERYT województwa lub pusty/all
//   _hazardCode — domyślnie Z02, dla strony dezinformacji Z20
// Uwaga: część zapytań pokazuje sam fakt operacyjny bez joinu do wymiarów, bo w Eventhouse
// typowo trzymamy telemetrię. Drill-down geograficzny można realizować przez Lakehouse/Power BI.

// 01. Kafelek: „Mapa wodowskazów” | Strona: Hydrologia
// Co liczy: ostatni status każdego wodowskazu względem progów ostrzegawczych i alarmowych.
// Parametry: przedział czasu opcjonalny; województwo przez join do wymiaru w modelu semantycznym.
// Oczekiwany wynik na danych demo: 120 rekordów w `hydro_latest`; statusy normalny/ostrzegawczy/alarm.
// Kafelek typu mapa wymaga współrzędnych, dlatego dołączamy wymiar wodowskazów i gmin.
hydro_latest
| extend status = case(level_cm >= alarm_level_cm, "alarm", level_cm >= warning_level_cm, "ostrzegawczy", "normalny")
| join kind=inner (dim_river_gauge | project gauge_id, gauge_name, lat, lon) on gauge_id
| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code
| project gauge_name, river, gmina_name, level_cm, warning_level_cm, alarm_level_cm, trend, status, lat, lon
| order by level_cm desc

// 02. Kafelek: „Fala Kłodzko → Nysa → Opole → Wrocław” | Strona: Hydrologia
// Co liczy: przebieg poziomu wody dla kluczowych wodowskazów trasy fali wezbraniowej.
// Parametry: _startTime, _endTime; domyślnie 2026-09-12T12:00:00+02:00 ... 2026-09-25T12:00:00+02:00.
// Oczekiwany wynik: piki przesunięte w czasie: Kłodzko 493 cm, Nysa 512 cm, Opole 520 cm, Wrocław 536 cm.
hydro_readings
| where gauge_id in ("WG-001", "WG-003", "WG-004", "WG-007")
| summarize avg_level=avg(level_cm), max_level=max(level_cm) by bin(timestamp, 1h), gauge_id, river
| order by timestamp asc

// 03. Kafelek: „Gminy w alarmie” | Strona: Obraz kraju
// Co liczy: unikalne gminy, w których dowolny wodowskaz przekroczył stan alarmowy.
// Parametry: _startTime/_endTime; filtr województwa przez relację gmina→powiat→woj.
// Oczekiwany wynik dla pełnego zakresu demo: 10 gmin w alarmie.
// Kafelek typu multistat wymaga par etykieta-wartość, stąd `evaluate narrow()`.
hydro_readings
| where level_cm >= alarm_level_cm
| summarize ["Gminy w alarmie"]=dcount(gmina_code), ["Wodowskazy w alarmie"]=dcount(gauge_id), ["Rzeki w alarmie"]=dcount(river)
| evaluate narrow()
| project Wskaznik=Column, Wartosc=toint(Value)

// 04. Kafelek: „Zgłoszenia 112/PSP 15 min” | Strona: Obraz kraju
// Co liczy: liczbę incydentów, osoby objęte zgłoszeniami i najwyższy priorytet w oknach 15 min.
// Parametry: _hazardCode=Z02, _startTime/_endTime, opcjonalnie województwo po gminie.
// Oczekiwany wynik: 4943 incydenty w pełnym zbiorze, peak 15-min = 12.
incident_reports
| where hazard_code == "Z02"
| summarize incidents=count(), affected=sum(affected_people), max_priority=max(priority) by bin(timestamp, 15m)
| order by timestamp asc

// 05. Kafelek: „Top gmin wedlug incydentow” | Strona: Obraz kraju
// Co liczy: ranking gmin z najwieksza liczba zgloszen i osob objetych zgloszeniami.
// Parametry: _startTime/_endTime, _hazardCode. Wynik: wykres slupkowy poziomy dla oficera dyzurnego.
incident_reports
| where hazard_code == "Z02"
| summarize Zgloszenia = count(), Osoby = sum(affected_people) by gmina_code
| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code
| top 15 by Zgloszenia desc
| project Gmina = coalesce(gmina_name, gmina_code), Zgloszenia, Osoby
| order by Zgloszenia asc


// 06. Kafelek: „Odbiorcy bez prądu” | Strona: Infrastruktura krytyczna
// Co liczy: godzinową sumę odbiorców bez prądu i liczbę zdarzeń energetycznych.
// Parametry: _startTime/_endTime, opcjonalnie województwo. Oczekiwany peak demo: 24057 w 2026-09-17T08:00.
power_grid_events
| summarize customers_offline=sum(customers_offline), events=count(), max_eta=max(eta_restore_min) by bin(timestamp, 1h)
| order by timestamp asc

// 07. Kafelek: „Awarie energetyczne — najciezsze gminy” | Strona: Infrastruktura krytyczna
// Co liczy: gminy z najwieksza liczba odbiorcow bez pradu wraz z najdluzszym czasem przywrocenia.
// Parametry: _startTime/_endTime. Wynik: wykres kolumnowy dla dyzurnego infrastruktury.
power_grid_events
| summarize Odbiorcy = sum(customers_offline), MaxETA = max(eta_restore_min) by gmina_code
| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code
| top 15 by Odbiorcy desc
| project Gmina = coalesce(gmina_name, gmina_code), Odbiorcy, MaxETA
| order by Odbiorcy desc


// 08. Kafelek: „Gminy z pokryciem telco <50%” | Strona: Infrastruktura krytyczna
// Co liczy: najnizsze aktualne pokrycie telekomunikacyjne w gminach.
// Parametry: _startTime/_endTime. Wynik: wykres slupkowy poziomy, 15 najgorszych gmin.
telecom_events
| where coverage_pct < 50
| summarize arg_max(timestamp, coverage_pct, base_stations_down) by gmina_code
| join kind=leftouter (dim_gmina | project gmina_code, gmina_name) on gmina_code
| top 15 by coverage_pct asc
| project Gmina = coalesce(gmina_name, gmina_code), Pokrycie = coverage_pct, Stacje = base_stations_down
| order by Pokrycie desc


// 09. Kafelek: „Status ewakuacji” | Strona: Obraz kraju / RZZK i SPO
// Co liczy: najnowszy status per gmina oraz sumę osób w ewakuacjach.
// Parametry: przedział czasu; opcjonalnie województwo. Oczekiwany wynik: suma najnowszych statusów 56212 osób.
// Kafelek typu multistat wymaga par etykieta-wartość, stąd `evaluate narrow()`.
evacuation_status
| summarize arg_max(timestamp, *) by gmina_code
| summarize ["Osoby w ewakuacji"]=sum(people_count), ["Gminy z ewakuacja"]=dcount(gmina_code), ["Miejsca w punktach przyjecia"]=sum(reception_capacity)
| evaluate narrow()
| project Wskaznik=Column, Wartosc=toint(Value)

// 10. Kafelek: „Zaangazowane sily i srodki” | Strona: Obraz kraju
// Co liczy: ostatni raport zasobow per wojewodztwo: PSP, WOT, pompy, agregaty, smiglowce.
// Parametry: _voivodeshipCode. Wynik: wykres kolumnowy wieloseryjny, widoczny wzrost w woj. 02 i 16.
resource_deployment
| summarize arg_max(timestamp, psp_units, wot_soldiers, pumps, generators, helicopters) by voivodeship_code
| join kind=leftouter (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code
| extend Razem = psp_units + wot_soldiers + pumps + generators + helicopters
| top 10 by Razem desc
| project Wojewodztwo = coalesce(voivodeship_name, voivodeship_code), PSP = psp_units, WOT = wot_soldiers,
          Pompy = pumps, Agregaty = generators, Smiglowce = helicopters


// 11. Kafelek: „Ostatnie eskalacje i SPO” | Strona: RZZK i SPO
// Co liczy: sekwencję eskalacji gmina→powiat→wojewoda→minister→RZZK oraz rekomendowaną SPO.
// Parametry: _hazardCode=Z02, _startTime/_endTime. Oczekiwany wynik: 5 zdarzeń, w tym minister wiodący→RZZK w D0.
escalation_events
| where hazard_code == "Z02"
| order by timestamp asc
| project timestamp, from_level, to_level, area, recommended_spo, reason

// 12. Kafelek: „Sygnały dezinformacyjne Z20” | Strona: Z20 Dezinformacja
// Co liczy: liczbę sygnałów z flagą dezinformacji i ich zasięg w czasie.
// Parametry: _hazardCode=Z20 albo disinformation_flag=true, _startTime/_endTime.
// Oczekiwany wynik: 363 sygnały dezinformacyjne, łączny zasięg 39854793.
media_signals
| where disinformation_flag == true or hazard_code == "Z20"
| summarize disinfo_signals=count(), disinfo_reach=sum(reach), topics=make_set(topic, 5) by bin(timestamp, 1h)
| order by timestamp asc

// 13. Kafelek: „Kanaly i tematy Z20” | Strona: Z20 Dezinformacja
// Co liczy: udzial kanalow w zasiegu przekazu dezinformacyjnego.
// Parametry: _startTime/_endTime. Wynik: wykres pierscieniowy z udzialem procentowym.
media_signals
| where disinformation_flag == true
| summarize Zasieg = sum(reach), Sygnaly = count() by channel
| project Kanal = channel, Zasieg, Sygnaly
| order by Zasieg desc


// 14. Kafelek: „Korelacja hydro → energia → telco” | Strona: Infrastruktura krytyczna
// Co liczy: dla gmin z alarmem hydro pokazuje pierwszą awarię energii i telco oraz opóźnienia godzinowe.
// Parametry: _startTime/_endTime, opcjonalnie województwo. Wynik: tabela do rozmowy o kaskadzie IK.
let hydro_alarm = hydro_readings
| where level_cm >= alarm_level_cm
| summarize first_alarm=min(timestamp) by gmina_code;
let power_first = power_grid_events
| summarize first_power=min(timestamp), customers=sum(customers_offline) by gmina_code;
let telco_first = telecom_events
| summarize first_telco=min(timestamp), min_coverage=min(coverage_pct) by gmina_code;
hydro_alarm
| join kind=leftouter power_first on gmina_code
| join kind=leftouter telco_first on gmina_code
| extend power_delay_h=datetime_diff('hour', first_power, first_alarm), telco_delay_h=datetime_diff('hour', first_telco, first_alarm)
| project gmina_code, first_alarm, first_power, power_delay_h, customers, first_telco, telco_delay_h, min_coverage
| order by first_alarm asc


// 15. Kafelek: „Heatmapa zgloszen: wojewodztwo x doba” | Strona: Obraz kraju
// Co liczy: natezenie zgloszen w ukladzie wojewodztwo x doba, aby jednym rzutem oka wskazac ognisko.
// Parametry: _startTime/_endTime. Wynik: mapa ciepla, wyrazne skupisko w woj. dolnoslaskim i opolskim.
incident_reports
| join kind=inner (dim_gmina | project gmina_code, powiat_code) on gmina_code
| join kind=inner (dim_powiat | project powiat_code, voivodeship_code) on powiat_code
| join kind=inner (dim_voivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code
| summarize Zgloszenia = count() by Wojewodztwo = voivodeship_name, Doba = format_datetime(bin(timestamp, 1d), 'MM-dd')
| order by Doba asc


// 16. Kafelek: „Osoby objete zdarzeniem — narastajaco” | Strona: Obraz kraju
// Co liczy: skala zdarzenia w czasie, narastajaco, jako krzywa dla kierownictwa.
// Parametry: _startTime/_endTime. Wynik: krzywa z wyraznym zalamaniem w D0.
incident_reports
| summarize Osoby = sum(affected_people) by Czas = bin(timestamp, 1h)
| order by Czas asc
| extend Skumulowane = row_cumsum(Osoby)


// 17. Kafelek: „Mapa incydentow: intensywnosc w gminach” | Strona: Obraz kraju
// Co liczy: liczbe zgloszen i osoby objete zdarzeniem w kazdej gminie, naniesione na mape kraju.
// Parametry: _startTime/_endTime. Wynik: skupisko bombelkow na Nysie Klodzkiej i w woj. opolskim.
incident_reports
| summarize Zgloszenia = count(), Osoby = sum(affected_people) by gmina_code
| join kind=inner (dim_gmina | project gmina_code, gmina_name, lat, lon) on gmina_code
| project Gmina = gmina_name, Zgloszenia, Osoby, lat, lon
| order by Zgloszenia desc

