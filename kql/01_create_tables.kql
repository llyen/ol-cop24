// 🧱 COP-24 Eventhouse schema — tabele strumieni i mapowania JSON
.create-merge table hydro_readings (timestamp:datetime, stream:string, gauge_id:string, gmina_code:string, river:string, level_cm:int, flow_m3s:real, trend:string, warning_level_cm:int, alarm_level_cm:int)
.create-merge table weather_observations (timestamp:datetime, stream:string, powiat_code:string, rain_mm_h:real, temperature_c:real, wind_kmh:real, phenomenon:string)
.create-merge table incident_reports (timestamp:datetime, stream:string, incident_id:string, source:string, hazard_code:string, event_type:string, gmina_code:string, priority:int, injured_count:int, affected_people:int, status:string)
.create-merge table power_grid_events (timestamp:datetime, stream:string, event_id:string, station:string, gmina_code:string, customers_offline:int, eta_restore_min:int, cause:string)
.create-merge table telecom_events (timestamp:datetime, stream:string, event_id:string, operator:string, gmina_code:string, base_stations_down:int, coverage_pct:real, cause:string)
.create-merge table evacuation_status (timestamp:datetime, stream:string, event_id:string, gmina_code:string, status:string, people_count:int, reception_capacity:int, spo_code:string)
.create-merge table resource_deployment (timestamp:datetime, stream:string, event_id:string, voivodeship_code:string, psp_units:int, wot_soldiers:int, pumps:int, generators:int, helicopters:int)
.create-merge table media_signals (timestamp:datetime, stream:string, signal_id:string, topic:string, sentiment:string, reach:int, disinformation_flag:bool, hazard_code:string, channel:string)
.create-merge table escalation_events (timestamp:datetime, stream:string, event_id:string, from_level:string, to_level:string, area:string, hazard_code:string, recommended_spo:string, reason:string)

.create-or-alter table hydro_readings ingestion json mapping 'hydro_json' '[{"column":"timestamp","path":"$.timestamp"},{"column":"stream","path":"$.stream"},{"column":"gauge_id","path":"$.gauge_id"},{"column":"gmina_code","path":"$.gmina_code"},{"column":"river","path":"$.river"},{"column":"level_cm","path":"$.level_cm"},{"column":"flow_m3s","path":"$.flow_m3s"},{"column":"trend","path":"$.trend"},{"column":"warning_level_cm","path":"$.warning_level_cm"},{"column":"alarm_level_cm","path":"$.alarm_level_cm"}]'
.create-or-alter table weather_observations ingestion json mapping 'weather_json' '[{"column":"timestamp","path":"$.timestamp"},{"column":"stream","path":"$.stream"},{"column":"powiat_code","path":"$.powiat_code"},{"column":"rain_mm_h","path":"$.rain_mm_h"},{"column":"temperature_c","path":"$.temperature_c"},{"column":"wind_kmh","path":"$.wind_kmh"},{"column":"phenomenon","path":"$.phenomenon"}]'
.create-or-alter table incident_reports ingestion json mapping 'incident_json' '[{"column":"timestamp","path":"$.timestamp"},{"column":"stream","path":"$.stream"},{"column":"incident_id","path":"$.incident_id"},{"column":"source","path":"$.source"},{"column":"hazard_code","path":"$.hazard_code"},{"column":"event_type","path":"$.event_type"},{"column":"gmina_code","path":"$.gmina_code"},{"column":"priority","path":"$.priority"},{"column":"injured_count","path":"$.injured_count"},{"column":"affected_people","path":"$.affected_people"},{"column":"status","path":"$.status"}]'
.create-or-alter table power_grid_events ingestion json mapping 'power_json' '[{"column":"timestamp","path":"$.timestamp"},{"column":"stream","path":"$.stream"},{"column":"event_id","path":"$.event_id"},{"column":"station","path":"$.station"},{"column":"gmina_code","path":"$.gmina_code"},{"column":"customers_offline","path":"$.customers_offline"},{"column":"eta_restore_min","path":"$.eta_restore_min"},{"column":"cause","path":"$.cause"}]'
.create-or-alter table telecom_events ingestion json mapping 'telecom_json' '[{"column":"timestamp","path":"$.timestamp"},{"column":"stream","path":"$.stream"},{"column":"event_id","path":"$.event_id"},{"column":"operator","path":"$.operator"},{"column":"gmina_code","path":"$.gmina_code"},{"column":"base_stations_down","path":"$.base_stations_down"},{"column":"coverage_pct","path":"$.coverage_pct"},{"column":"cause","path":"$.cause"}]'
.create-or-alter table evacuation_status ingestion json mapping 'evacuation_json' '[{"column":"timestamp","path":"$.timestamp"},{"column":"stream","path":"$.stream"},{"column":"event_id","path":"$.event_id"},{"column":"gmina_code","path":"$.gmina_code"},{"column":"status","path":"$.status"},{"column":"people_count","path":"$.people_count"},{"column":"reception_capacity","path":"$.reception_capacity"},{"column":"spo_code","path":"$.spo_code"}]'
.create-or-alter table resource_deployment ingestion json mapping 'resource_json' '[{"column":"timestamp","path":"$.timestamp"},{"column":"stream","path":"$.stream"},{"column":"event_id","path":"$.event_id"},{"column":"voivodeship_code","path":"$.voivodeship_code"},{"column":"psp_units","path":"$.psp_units"},{"column":"wot_soldiers","path":"$.wot_soldiers"},{"column":"pumps","path":"$.pumps"},{"column":"generators","path":"$.generators"},{"column":"helicopters","path":"$.helicopters"}]'
.create-or-alter table media_signals ingestion json mapping 'media_json' '[{"column":"timestamp","path":"$.timestamp"},{"column":"stream","path":"$.stream"},{"column":"signal_id","path":"$.signal_id"},{"column":"topic","path":"$.topic"},{"column":"sentiment","path":"$.sentiment"},{"column":"reach","path":"$.reach"},{"column":"disinformation_flag","path":"$.disinformation_flag"},{"column":"hazard_code","path":"$.hazard_code"},{"column":"channel","path":"$.channel"}]'
.create-or-alter table escalation_events ingestion json mapping 'escalation_json' '[{"column":"timestamp","path":"$.timestamp"},{"column":"stream","path":"$.stream"},{"column":"event_id","path":"$.event_id"},{"column":"from_level","path":"$.from_level"},{"column":"to_level","path":"$.to_level"},{"column":"area","path":"$.area"},{"column":"hazard_code","path":"$.hazard_code"},{"column":"recommended_spo","path":"$.recommended_spo"},{"column":"reason","path":"$.reason"}]'
